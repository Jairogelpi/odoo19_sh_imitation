<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="flight_recorder_trace_view_list" model="ir.ui.view">
        <field name="name">flight.recorder.trace.list</field>
        <field name="model">flight.recorder.trace</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="started_at"/>
                <field name="status"/>
                <field name="actor_id"/>
                <field name="root_model"/>
                <field name="root_record_id"/>
                <field name="root_operation"/>
                <field name="event_count"/>
                <field name="source_module"/>
                <field name="git_revision" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="flight_recorder_trace_view_form" model="ir.ui.view">
        <field name="name">flight.recorder.trace.form</field>
        <field name="model">flight.recorder.trace</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <button
                        name="action_export_incident"
                        string="Export Incident"
                        type="object"
                        class="btn-primary"
                        invisible="status != 'completed'"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="correlation_id"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="status"/>
                            <field name="actor_id"/>
                            <field name="started_at"/>
                            <field name="ended_at"/>
                        </group>
                        <group>
                            <field name="root_model"/>
                            <field name="root_record_id"/>
                            <field name="root_operation"/>
                            <field name="source_module"/>
                            <field name="source_path"/>
                            <field name="git_revision"/>
                        </group>
                    </group>
                    <field name="event_ids">
                        <list create="false" edit="false" delete="false">
                            <field name="sequence"/>
                            <field name="kind"/>
                            <field name="operation"/>
                            <field name="model_name"/>
                            <field name="record_id"/>
                            <field name="field_names"/>
                            <field name="source_module"/>
                            <field name="occurred_at"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="flight_recorder_trace_action" model="ir.actions.act_window">
        <field name="name">Flight Recorder Traces</field>
        <field name="res_model">flight.recorder.trace</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <record id="flight_recorder_capture_policy_view_list" model="ir.ui.view">
        <field name="name">flight.recorder.capture.policy.list</field>
        <field name="model">flight.recorder.capture.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="active"/>
                <field name="model_name"/>
                <field name="field_names"/>
            </list>
        </field>
    </record>

    <record id="flight_recorder_capture_policy_view_form" model="ir.ui.view">
        <field name="name">flight.recorder.capture.policy.form</field>
        <field name="model">flight.recorder.capture.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="active"/>
                        <field name="model_name" placeholder="sale.order"/>
                        <field
                            name="field_names"
                            placeholder='["state", "amount_total"]'
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="flight_recorder_capture_policy_action" model="ir.actions.act_window">
        <field name="name">Capture Policies</field>
        <field name="res_model">flight.recorder.capture.policy</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="flight_recorder_menu_root"
        name="Flight Recorder"
        sequence="95"
        groups="base.group_system"
    />
    <menuitem
        id="flight_recorder_menu_traces"
        name="Traces"
        parent="flight_recorder_menu_root"
        action="flight_recorder_trace_action"
        sequence="10"
        groups="base.group_system"
    />
    <menuitem
        id="flight_recorder_menu_capture_policies"
        name="Capture Policies"
        parent="flight_recorder_menu_root"
        action="flight_recorder_capture_policy_action"
        sequence="20"
        groups="base.group_system"
    />
</odoo>
